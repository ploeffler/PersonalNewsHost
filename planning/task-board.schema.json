{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "active_version",
    "branch",
    "tasks",
    "packages",
    "releases",
    "source_sha256",
    "dependency_layers",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "active_version": {
      "type": "string"
    },
    "branch": {
      "const": "Full-featured-Newsoutlet"
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "dependency_layers": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "tasks"
        ]
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "title",
          "tasks",
          "acceptance"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "epic",
          "title",
          "status",
          "depends_on",
          "instructions",
          "acceptance",
          "source",
          "version",
          "package",
          "lease",
          "review",
          "local_work_pending",
          "evidence",
          "implementation_note",
          "coordination_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]{3}$"
          },
          "epic": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "todo",
              "in_progress",
              "review",
              "done",
              "blocked"
            ]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "lease": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "client",
                  "token",
                  "expires_at",
                  "files"
                ],
                "properties": {
                  "client": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": "number"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "review": {
            "type": [
              "object",
              "null"
            ]
          },
          "local_work_pending": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation_note": {
            "type": "string"
          },
          "coordination_note": {
            "type": "string"
          }
        }
      }
    }
  }
}
