digraph workflow {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.25", ranksep="0.3", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Experimental video pipeline"];
  node [shape=box, style="rounded,filled", color="#cbd5e1", fillcolor="#f1f5f9", fontname="DejaVu Sans", fontsize=13, fontcolor="#17243b", margin="0.2,0.13", width=3.5];
  edge [color="#64748b", arrowsize=0.7, penwidth=1.3];
  rss [label="RSS feeds", fillcolor="#dbeafe"];
  analysis [label="scripts/analyze_topics.py", fillcolor="#f1f5f9"];
  plan [label="scripts/build_broadcast_plan.py", fillcolor="#f1f5f9"];
  segments [width=1.6, label="Parallel news segments\nPiper + FFmpeg", fillcolor="#ffedd5"];
  avatar [width=1.6, label="Optional MuseTalk segments\nExperimental", fillcolor="#ffedd5"];
  assembly [label="scripts/assemble_segments.py", fillcolor="#f1f5f9"];
  artifact [label="Test artifact\nNot automatically published", fillcolor="#dcfce7"];
  {rank=same; segments; avatar;}
  rss -> analysis;
  analysis -> plan;
  plan -> segments;
  plan -> avatar;
  segments -> assembly;
  avatar -> assembly;
  assembly -> artifact;
}
