{
  "title": "PersonalNewsHost",
  "production_version": "1.0",
  "language": "de",
  "voice": "de",
  "max_items": 5,
  "max_description_chars": 180,
  "feeds": [
    "https://www.derstandard.at/rss",
    "https://www.derstandard.at/rss/live",
    "https://api.krone.at/v1/rss/rssfeed-nachrichten.html",
    "https://rss.orf.at/news.xml",
    "https://www.kleinezeitung.at/rss/steiermark",
    "https://www.kleinezeitung.at/rss/oesterreich",
    "https://www.bmi.gv.at/rss/stmk_presse.xml"
  ],
  "background": "assets/background.jpg",
  "presenter": "assets/presenter.png",
  "tts_engine": "piper",
  "piper_length_scale": 1.06,
  "presenter_settings": {
    "name": "NewsHost",
    "gender": "custom",
    "portrait": "assets/presenter.png",
    "background": "assets/background.jpg",
    "voice_model": "de_DE-thorsten-high",
    "lip_sync": {
      "enabled": true,
      "engine": "audio_envelope",
      "fallback": "static",
      "mouth": {
        "x": 0.5,
        "y": 0.34,
        "width": 0.13,
        "height": 0.045
      },
      "note": "Offline speech-energy mouth deformation (not phoneme-accurate neural lip sync)",
      "fps": 20
    },
    "scenes": {
      "show_headlines": true,
      "intro_mode": "avatar",
      "intro_text": "Willkommen bei {title}. Hier sind die Nachrichten.",
      "outro_text": "Das waren die Schlagzeilen. Quellen und Links finden Sie auf unserer Webseite.",
      "intro_static_type": "color",
      "intro_static_color": "#13243a",
      "intro_static_image": "assets/background.jpg"
    },
    "desk_foreground": "assets/desk_foreground.png"
  },
  "voice_pitch_semitones": -1.5,
  "telegram": {
    "enabled": true,
    "recipient_type": "channel",
    "delivery": "auto",
    "caption": "{title} – neue Nachrichtensendung\n{url}",
    "target": "default"
  },
  "automation": {
    "enabled": true,
    "interval_hours": 3,
    "start_hour_local": 0,
    "timezone": "Europe/Vienna",
    "days": "daily"
  },
  "advanced_services": {
    "processing_region": "eu",
    "processing_country": "",
    "require_verified_region": true,
    "news_provider": "disabled",
    "voice_provider": "local",
    "avatar_provider": "static",
    "video_provider": "local",
    "max_per_video_eur": 0,
    "max_per_month_eur": 0,
    "allow_paid": false
  },
  "editorial": {
    "style": "classic",
    "max_sentences": 2,
    "crosscheck": {
      "enabled": true,
      "max_sources": 2,
      "method": "independent_publisher_headline_search",
      "note": "Finds other publisher coverage, not factual verification of individual claims"
    },
    "topic_clustering": {
      "enabled": true,
      "mode": "conservative",
      "note": "Groups only highly similar headlines; does not fabricate a unified narrative"
    },
    "selection": {
      "mode": "freshness_and_source_diversity",
      "note": "Newest first, with one story per distinct publisher before filling remaining slots"
    },
    "broadcast_sections": {
      "enabled": false,
      "default": "general",
      "sections": [
        {
          "id": "general",
          "label": "Allgemein",
          "keywords": []
        },
        {
          "id": "economy",
          "label": "Wirtschaft",
          "keywords": [
            "Wirtschaft",
            "Inflation",
            "Börse",
            "Zinsen",
            "Arbeitsmarkt",
            "Konjunktur"
          ]
        },
        {
          "id": "local",
          "label": "Lokales",
          "keywords": []
        }
      ],
      "feed_sections": {
        "https://www.bmi.gv.at/rss/stmk_presse.xml": "local",
        "https://www.kleinezeitung.at/rss/steiermark": "local"
      }
    }
  },
  "media": {
    "mode": "images_and_videos",
    "max_download_mb": 12,
    "web_image_fallback": true,
    "enhancement": "ai",
    "enhancement_modes": [
      "off",
      "balanced",
      "ai"
    ],
    "prefer_article_images": true
  },
  "station_logo": "assets/logo-video.png"
}
